flowchart TD
  Intent["User Intent\n(topic · audience · tone · platform)"]
  Intent --> Reframing

  subgraph Reframing["Stage 2 — Creative Reframing (Bob session 2)"]
    direction LR
    skeptic["skeptic"] & advocate["advocate"] & contrarian["contrarian"] --> chosen_angle["chosen_angle\n(user picks)"]
  end

  Reframing --> AgentCrew

  subgraph AgentCrew["Production Crew — 21 Agents"]
    direction LR
    shotdesigner["ShotDesignerAgent\nShot.camera · Shot.lighting"]
    character["CharacterDirectorAgent\nProduction.characters"]
    storyboard["StoryboardArtistAgent\nShot.storyboard_frame"]
    environment["EnvironmentArtistAgent\nProduction.environments"]
    reviewer["ReviewerAgent\n(evaluator)"]
    editor["EditorAgent\nTimeline.scene_order"]
    publisher["PublisherAgent\nProduction.metadata"]
    voice["VoiceDirectorAgent\nShot.audio.voice_direction"]
    sound["SoundDesignerAgent\nShot.audio.sfx"]
    music["MusicComposerAgent\nTimeline.music_cues"]
    colorist["ColoristAgent\nShot.color_spec"]
  end

  AgentCrew --> Gates

  subgraph Gates["Fail-Closed Gate Suite (Bob session 3)"]
    evidence_gate["EvidenceGate\n(fail-closed)"]
    consistency_gate["ConsistencyGate\n(fail-closed)"]
    contract_gate["ConsistencyContractGate\n(fail-closed)"]
    publication_gate["PublicationGate\n(fail-closed)"]
    evidence_gate --> consistency_gate --> contract_gate --> publication_gate
  end

  Gates --> Output

  subgraph Output["Dual-Artifact Output (ACT-8)"]
    prod_json["production.json\n(current state snapshot)"]
    audit_jsonl["audit.jsonl\n(append-only event journal)"]
    prod_json -. append-only .-> audit_jsonl
  end

  Output --> UI

  subgraph UI["Browser Views (MVP)"]
    guided["Guided Flow\n/?view=guided"]
    console["Agent Console\n/?view=console"]
    guided -. production_id .-> console
  end

  subgraph ProductionService["ProductionService (src/service/production_service.py)"]
    state_machine["6-state machine\nDRAFT→BRIEFED→IN_PRODUCTION\n→IN_REVIEW→APPROVED→PUBLISHED"]
    apply_event["apply_event()\n(pure, forward-only)"]
    snapshot["snapshot()\ncontent-addressed"]
    branch["create_branch()\nnamed forks"]
  end

  AgentCrew -. reads/writes .-> ProductionService
  Gates -. audit entries .-> ProductionService
  ProductionService --> Output

  classDef bobStyle fill:#7AC9F2,stroke:#0A0E1A,color:#0A0E1A,stroke-width:2px
  classDef gateStyle fill:#86E09C,stroke:#0A0E1A,color:#0A0E1A
  classDef failClosedStyle fill:#FF8A8A,stroke:#0A0E1A,color:#0A0E1A
  classDef uiStyle fill:#d4b4fe,stroke:#0A0E1A,color:#0A0E1A
  classDef svcStyle fill:#fde68a,stroke:#0A0E1A,color:#0A0E1A
  class chosen_angle bobStyle
  class evidence_gate,publication_gate gateStyle
  class consistency_gate,contract_gate failClosedStyle
  class guided,console uiStyle
  class ProductionService svcStyle
