# LLM provider key (gpt-4o-mini recommended for cost)
# OPENAI_API_KEY=sk-...

# MiniMax (OpenAI-compatible chat completions)
# Use the base URL and model name shown in your MiniMax account/docs.
# MINIMAX_API_KEY=...
# MINIMAX_BASE_URL=https://api.minimax.example/v1
# MINIMAX_MODEL=MiniMax-M2

# Any other OpenAI-compatible provider
# LLM_API_KEY=...
# LLM_BASE_URL=https://provider.example/v1
# LLM_MODEL=provider-model-name

# IBM Bob trial (used by Bob sessions, not by the runtime)
# BOB_TRIAL_EMAIL=...